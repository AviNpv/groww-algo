# ==========================================================================
#  GROWW ALGO — environment
#  Copy this file to .env and fill in the values you have.
#  The bot runs on Yahoo delayed data when these are empty.
# ==========================================================================

# --- Groww API (read-only market data) ------------------------------------
# The "TOTP token" API key from https://groww.in/trade-api/api-keys
GROWW_TOTP_TOKEN=

# The base32 secret behind the authenticator entry for the same API key.
# Needed for automatic daily token minting (150 mints/day limit).
GROWW_TOTP_SECRET=

# Optional: paste a current access token to skip minting entirely.
# Expires daily; the cached token in data/cache/groww_access_token.json wins
# while it is still valid.
GROWW_ACCESS_TOKEN=

# --- Optional ------------------------------------------------------------
# 1 = never attempt any order call (this build has no order code anyway)
GROWW_DATA_ONLY=1

# --- Runtime intelligence (paper-only advisory layer, default OFF) --------
# Enable the six-agent layer by setting intelligence.enabled: true in
# config/strategy.yaml AND configuring one of the keys below. Without a
# configured model, AI-dependent entries fail closed.
# Free Groq key (default api_key_env in config/strategy.yaml):
GROQ_API_KEY=
# Alternative allowlisted variable name if you do not want to use GROQ_API_KEY:
# INTELLIGENCE_MODEL_API_KEY=

# Required for the Evolution run / Promote / Rollback buttons. If unset,
# those mutation endpoints return HTTP 503. Use a long random local secret and
# enter it in the Intelligence tab's Operator token field (sessionStorage only).
# Never commit the real value.
INTELLIGENCE_ADMIN_TOKEN=
